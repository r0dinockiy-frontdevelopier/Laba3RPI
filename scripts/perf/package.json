  "version": "1.0.0",
  "type": "module",
  "description": "Скрипты замеров производительности (Lighthouse + Puppeteer/CDP) для отчёта по рефакторингу навигации",
  "scripts": {
    "serve:after": "node serve.mjs ../../dist 4180",
